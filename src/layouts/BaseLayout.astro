---
import faviconSvg from "../assets/favicon.svg?url";
import faviconPng from "../assets/favicon.png";
import appleTouchIcon from "../assets/apple-touch-icon.png";
import "../styles/global.css";

interface Props {
  title: string;
  ogTitle?: string;
  description?: string;
  canonical?: string;
  ogType?: string;
  ogImage?: string | null;
  googleSiteVerification?: string;
}

const {
  title,
  ogTitle = title,
  description,
  canonical,
  ogType = "website",
  ogImage = null,
  googleSiteVerification,
} = Astro.props;

const SITE_TITLE = "Dan Farrelly";
const DOMAIN = "https://danfarrelly.com";

// og:url always points at the local page; only <link rel="canonical"> may
// point elsewhere (posts first published on another site).
const localUrl = `${DOMAIN}${Astro.url.pathname}`;

const PROJECTS = [
  { name: "Inngest", url: "https://www.inngest.com", stars: "5.7k" },
  { name: "MailDev", url: "https://maildev.github.io/maildev/", stars: "6k" },
  { name: "Timezone.io", url: "https://github.com/timezoneio/timezoneio" },
];

const SOCIAL = [
  { name: "X", url: "https://x.com/djfarrelly" },
  { name: "GitHub", url: "https://github.com/djfarrelly" },
  { name: "LinkedIn", url: "https://www.linkedin.com/in/djfarrelly/" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#546B41" />

    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical ?? localUrl} />

    <meta property="og:title" content={ogTitle} />
    <meta property="og:url" content={localUrl} />
    {description && <meta property="og:description" content={description} />}
    {!!ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="og:type" content={ogType} />
    {ogType === "article" && (
      <meta property="og:article:author" content={`${DOMAIN}/`} />
    )}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:creator" content="@djfarrelly" />
    {googleSiteVerification && (
      <meta name="google-site-verification" content={googleSiteVerification} />
    )}

    <link rel="icon" type="image/svg+xml" href={faviconSvg} />
    <link rel="icon" type="image/png" sizes="32x32" href={faviconPng.src} />
    <link rel="apple-touch-icon" href={appleTouchIcon.src} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Dan Farrelly's blog"
      href="/rss.xml"
    />

    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-LPL5HN33SL"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-LPL5HN33SL");
    </script>
  </head>
  <body class="flex min-h-dvh flex-col bg-paper font-sans text-ink antialiased">
    <header>
      <div class="mx-auto flex w-full max-w-3xl items-center justify-between px-6 py-6">
        <a
          href="/"
          class="text-sm font-bold tracking-tight transition-colors hover:text-accent"
        >
          {SITE_TITLE}
        </a>
        <nav class="flex gap-6 text-sm text-muted">
          <a href="/speaking-and-press/" class="transition-colors hover:text-accent">
            Speaking&nbsp;&amp;&nbsp;Press
          </a>
          <a href="/about/" class="transition-colors hover:text-accent">
            About
          </a>
        </nav>
      </div>
    </header>

    <main class="mx-auto w-full max-w-2xl flex-1 px-6">
      <slot />
    </main>

    <footer class="mx-auto w-full max-w-2xl px-6 pb-14 pt-10">
      <div class="border-t border-line pt-6 text-sm text-muted">
        <ul class="flex flex-wrap gap-x-5 gap-y-2">
          {
            PROJECTS.map(({ name, url: projectUrl, stars }) => (
              <li>
                <a
                  href={projectUrl}
                  class="font-medium transition-colors hover:text-accent"
                >
                  {name}
                </a>
                {stars && <span class="text-xs text-muted/70"> ({stars})</span>}
              </li>
            ))
          }
        </ul>
        <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-2">
          {
            SOCIAL.map(({ name, url: socialUrl }) => (
              <li>
                <a href={socialUrl} class="transition-colors hover:text-accent">
                  {name}
                </a>
              </li>
            ))
          }
        </ul>
        <p class="mt-6 text-xs text-muted/70">&copy; 2026 Dan Farrelly</p>
      </div>
    </footer>
  </body>
</html>