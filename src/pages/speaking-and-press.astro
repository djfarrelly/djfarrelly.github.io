---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatDate } from "../lib/format.js";

const DESCRIPTION =
  "Selected talks, podcasts, interviews, and press featuring Dan Farrelly.";

const sortKey = (date) => date ?? "0";

const entries = (await getCollection("speakingPress")).sort((a, b) =>
  sortKey(b.data.date).localeCompare(sortKey(a.data.date)),
);
---

<BaseLayout
  title="Speaking & Press - Dan Farrelly"
  ogTitle="Speaking & Press"
  description={DESCRIPTION}
>
  <section class="py-10">
    <h1 class="text-3xl font-bold">Speaking &amp; Press</h1>
    <p class="mt-3 max-w-prose text-muted">
      A chronological list of selected talks, podcasts, interviews, and press.
    </p>

    <ul class="mt-8 divide-y divide-line">
      {
        entries.map(({ data: entry }) => (
          <li class="py-5">
            <div class="grid sm:grid-cols-5 gap-x-4 gap-y-1">
              <h2 class="font-semibold leading-snug col-span-4">
                {entry.title}
              </h2>
              <div class="text-right">
                <span class="rounded-full border border-line px-2.5 py-0.5 text-[11px] font-medium uppercase tracking-wider text-muted">
                  {entry.type}
                </span>
              </div>
            </div>
            <p class="mt-1 text-sm text-muted">
              {entry.source}
              {entry.date && (
                <>
                  {" "}
                  &middot;{" "}
                  <time dateTime={entry.date}>{formatDate(entry.date)}</time>
                </>
              )}
            </p>
            {entry.links.length > 0 && (
              <p class="mt-2 flex flex-wrap gap-x-5 gap-y-1 text-sm">
                {entry.links.map(({ label, url }) => (
                  <a
                    href={url}
                    class="text-accent transition-colors hover:text-accent-strong"
                  >
                    {label} &rarr;
                  </a>
                ))}
              </p>
            )}
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
