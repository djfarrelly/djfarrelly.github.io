---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import { formatDate, formatMonthYear, getPostUrl } from "../lib/format.js";

const DESCRIPTION =
  "Co-founder and CTO at Inngest. Writing about building agentic systems, software engineering, and event-driven architecture.";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => (b.data.date ?? "").localeCompare(a.data.date ?? ""))
  .slice(0, 5);

const PROJECTS = [
  { name: "Inngest", url: "https://www.inngest.com", stars: "5.9k" },
  { name: "MailDev", url: "https://maildev.github.io/maildev/", stars: "6.1k" },
];
---

<BaseLayout
  title="Dan Farrelly"
  description={DESCRIPTION}
  googleSiteVerification="MKYWJyvqSUEJDS-W42zXoEUZOggAoyKsobl6XU6-uCw"
  isHomepage={true}
>
  <section class="pt-[clamp(4rem,10vh,8rem)] mb-16">
    <img
      src="/images/headshot-2026-09-640px.png"
      alt="Dan Farrelly"
      width="96"
      height="96"
      class="size-24 rounded-full object-cover ring-1 ring-line"
    />
    <Header />
    <div class="max-w-prose text-base leading-relaxed text-ink">
      <p class="mb-4">
        I'm the co-founder at CTO of <a href="https://www.inngest.com/"
          >Inngest</a
        >, a developer platform for reliable orchestration of any asynchronous
        code. I do fractional work and advising through <a
          href="https://2525.tech/">2525.tech</a
        >.
      </p>
      <p class="my-4">
        I write about agentic systems and software architecture among other
        topics, build open source projects, and speak at events.
      </p>
      <p class="my-4">
        <a href="https://www.linkedin.com/in/djfarrelly/">Get in touch &rarr;</a
        >
      </p>
    </div>
  </section>

  <section class="my-10">
    <h2 class="text-sm font-bold uppercase tracking-widest text-muted">
      Latest writing
    </h2>
    <ul class="my-2 divide-y divide-line divide-">
      {
        posts.map((post) => (
          <li class="py-4 flex flex-col sm:flex-row justify-between sm:items-center">
            <a href={getPostUrl(post.id)} class="group block">
              <h3 class="transition-colors">{post.data.title}</h3>
            </a>
            <p class="mt-1 sm:mt-0 text-sm text-muted">
              <time dateTime={post.data.date}>
                {formatMonthYear(post.data.date)}
              </time>
            </p>
          </li>
        ))
      }
    </ul>
    <p class="mt-4">
      <a
        href="/blog/"
        class="text-sm text-muted transition-colors hover:text-accent"
      >
        All writing &rarr;
      </a>
    </p>
  </section>

  <section class="my-16">
    <h2 class="text-sm font-bold uppercase tracking-widest text-muted">
      Projects
    </h2>
    <ul class="my-2 divide-y divide-line divide-">
      {
        PROJECTS.map((project) => (
          <li class="py-4 flex flex-col sm:flex-row justify-between sm:items-center">
            <a href={project.url} class="group block">
              <h3 class="transition-colors">{project.name}</h3>
            </a>
            <p class="mt-1 sm:mt-0 text-sm text-muted">
              {project.stars && (
                <span class="text-xs text-muted/70"> ⭐︎ {project.stars}</span>
              )}
            </p>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
