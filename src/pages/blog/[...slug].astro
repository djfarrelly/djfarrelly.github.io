---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  formatDate,
  getFullImageUrl,
  getFullPostUrl,
} from "../../lib/format.js";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { data } = post;
const { Content } = await render(post);

const url = getFullPostUrl(post.id);
const imageUrl = getFullImageUrl(data.image);
// Posts syndicated to another site point their canonical URL at the original;
// everything else is canonical to itself. Posts that first appeared as an X
// thread use originUrl — shown in the UI only, never in meta tags.
const canonicalUrl = data.canonical || url;
const originUrl = data.canonical ?? data.originUrl;

const structuredData = {
  "@context": "http://schema.org",
  "@type": "BlogPosting",
  url,
  headline: data.title,
  datePublished: data.date,
  image: imageUrl,
  author: { "@type": "Person", name: "Dan Farrelly" },
  publisher: { "@type": "Person", name: "Dan Farrelly" },
};
---

<BaseLayout
  title={`${data.title} - Dan Farrelly`}
  ogTitle={data.title}
  description={data.description}
  canonical={canonicalUrl}
  ogType="article"
  ogImage={imageUrl}
>
  <article class="py-10">
    <header>
      <h1 class="text-balance text-3xl font-bold leading-tight">
        {data.title}
      </h1>
      {
        data.date && (
          <p class="mt-3 text-sm text-muted">
            <time dateTime={data.date}>{formatDate(data.date)}</time> by Dan
            Farrelly
          </p>
        )
      }
    </header>

    {
      originUrl && (
        <p class="mt-6 rounded-lg border border-line px-4 py-3 text-sm text-muted">
          This article was originally posted on the{" "}
          <a
            href={originUrl}
            class="font-medium text-accent hover:text-accent-strong"
          >
            {data.canonicalSource}
          </a>
          {data.xImpressions ? ` (${data.xImpressions}+ views)` : ""}.
        </p>
      )
    }

    <div class="prose mt-8">
      <Content />
    </div>
  </article>

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(structuredData)}
  />
</BaseLayout>
